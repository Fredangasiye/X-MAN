# Create a user-context OAuth 2.0 token with X write permission. Keep this file
# named .env (not committed). App-only bearer tokens cannot publish for you.
X_USER_ACCESS_TOKEN=

# dry_run logs exactly what would be posted without calling X.
DRY_RUN=true

# Your X username, without @. Used only for links in the dashboard.
X_USERNAME=

# Posting window in local server time. The app chooses a randomized time daily.
POSTS_PER_DAY=1
POST_WINDOW_START=09:00
POST_WINDOW_END=18:00
REPLIES_PER_DAY=0
